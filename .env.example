# ── Основное ────────────────────────────────────────────────────────────────
# Публичный адрес нужен для проверки Origin и абсолютных ссылок.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Секрет для подписи служебных значений (не равен паролю).
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── База данных ─────────────────────────────────────────────────────────────
# Локально по умолчанию используется встроенный PostgreSQL (PGlite) в ./data/pglite.
# Для production задайте DATABASE_URL — приложение переключится на обычный PostgreSQL.
# DATABASE_URL=postgres://user:password@host:5432/teplybox?sslmode=require
# PGLITE_DIR=./data/pglite

# ── Первый владелец ─────────────────────────────────────────────────────────
# Используется только при первом создании базы. После входа пароль меняется в «Доступе».
OWNER_EMAIL=owner@teplybox.example
OWNER_PASSWORD=teplybox-demo-2026
OWNER_NAME=Владелец

# Показывать демо-доступ на странице входа (только для демо-стенда).
DEMO_MODE=true

# Secure-cookie: true на HTTPS, false локально.
COOKIE_SECURE=false

# Часовой пояс заведения для дат и согласованного времени.
APP_TIMEZONE=Europe/Samara

# Лимиты попыток входа в кабинет (за 15 минут).
# По умолчанию: 20 на IP и 5 на пару IP + e-mail. Для демо и E2E можно поднять.
# ADMIN_LOGIN_IP_LIMIT=300
# ADMIN_LOGIN_PAIR_LIMIT=300
# Попыток в игре за 5 минут на IP. По умолчанию 12.
# ORDER_GAME_LIMIT=300

# ── ИИ-помощник ─────────────────────────────────────────────────────────────
# По умолчанию работает локальное детерминированное ядро: без ключей и без интернета.
# Оно берёт меню, цены и правила из базы и не выдумывает суммы.
# Необязательный LLM подключается только для вопросов, которые ядро не распознало.
# Внимание: путь с реальным ключом в демо не проверялся.
# ASSISTANT_LLM_KEY=
# ASSISTANT_LLM_URL=https://api.openai.com/v1/chat/completions
# ASSISTANT_LLM_MODEL=gpt-4o-mini
# Сообщений помощнику за 5 минут на IP. По умолчанию 60.
# ASSISTANT_RATE_LIMIT=200
